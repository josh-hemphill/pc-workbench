{
  "name": "pc-workbench",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "PC configuration, inventory and installation management with Node.js, pnpm, Vue and Vuetify.",
  "engines": {
    "node": ">=26.12.0 <27"
  },
  "packageManager": "pnpm@12.14.0",
  "dependencies": {
    "@mdi/js": "7.4.47",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "express": "5.3.0",
    "vue": "3.5.43",
    "vuetify": "4.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@neutralinojs/lib": "6.10.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@webviewjs/webview": "0.4.7",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  },
  "scripts": {
    "dev": "node --watch tools/node/dev.ts",
    "check": "vue-tsc --noEmit",
    "build:web": "node tools/node/frontend.ts build",
    "build:backend": "node tools/node/build-backend.ts",
    "build": "pnpm check && pnpm build:web && pnpm build:backend",
    "start": "node .standalone/server.cjs",
    "test": "node tools/node/test.mjs",
    "test:backend": "node --test tests/node-desktop.test.ts",
    "package:sea": "node tools/node/package-sea.mjs",
    "test:sea": "node tools/node/sea-smoke.mjs",
    "import:pcpartpicker": "node tools/pcpartpicker.ts",
    "dev:desktop": "node tools/node/desktop/main.ts",
    "dev:neutralino": "node tools/node/desktop/main.ts --neutralino",
    "build:desktop": "pnpm check && pnpm build:web && node tools/node/build-backend.ts --desktop-shell",
    "package:desktop": "node tools/node/package-sea.mjs --desktop-shell",
    "test:desktop-package": "node tools/node/sea-smoke.mjs --desktop-shell",
    "stage:tauri-sidecar": "node tools/node/stage-tauri-sidecar.mjs",
    "probe:runtime": "node tools/node/runtime-compatibility-probe.ts",
    "test:desktop-native": "node tools/node/native-webview-smoke.ts"
  }
}
